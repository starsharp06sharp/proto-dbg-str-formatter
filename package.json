{
    "name": "proto-dbg-str-formatter",
    "displayName": "proto-dbg-str formatter",
    "description": "protobuf debug string formatter",
    "version": "0.2.2",
    "publisher": "leolzheng",
    "repository": "https://github.com/starsharp06sharp/proto-dbg-str-formatter",
    "engines": {
        "vscode": "^1.45.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:prototxt",
        "onLanguage:textproto"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "prototxt",
                "aliases": [
                    "prototxt"
                ],
                "extensions": [
                    "prototxt"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "jison2js": "cd src/jison-prototxt && jison prototxt.jison",
        "compile": "npm run jison2js && tsc -p ./",
        "lint": "eslint src --ext ts",
        "watch": "npm run jison2js && tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.2",
        "@types/mocha": "^7.0.2",
        "@types/node": "^13.13.12",
        "@types/vscode": "^1.45.0",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "glob": "^7.1.6",
        "jison": "^0.4.18",
        "mocha": "^11.3.0",
        "typescript": "^3.9.5",
        "vscode-test": "^1.4.0"
    },
    "license": "MIT"
}